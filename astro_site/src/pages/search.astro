---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Search Japanese Verbs | Japanese Verb Conjugation"
  description="Search Japanese verbs by written form or reading."
>
  <section class="max-w-xl mx-auto text-center space-y-4">
    <h1 class="text-3xl font-bold">Search has moved</h1>
    <p class="text-base-content/70">
      Search and filters are now combined in the verb browser.
    </p>
    <a id="verb-browser-link" href="/verbs" class="btn btn-primary"
      >Browse verbs</a
    >
  </section>

  <script is:inline>
    const target = `/verbs${window.location.search}`;
    const link = document.getElementById("verb-browser-link");
    if (link) link.setAttribute("href", target);
    window.location.replace(target);
  </script>
</Layout>
