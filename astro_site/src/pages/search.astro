---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="max-w-2xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">Search</h1>
    <div class="mb-12 flex flex-col gap-4" data-pf-theme="dark">
      <pagefind-input></pagefind-input>
      <pagefind-summary></pagefind-summary>
      <pagefind-results>
        <script type="text/pagefind-template">
            <li class="custom-card p-4 border border-gray-200 rounded-lg">
                <h3 class="text-xl font-bold text-blue-800">
                    <a href="{{ url | safeUrl }}">{{ meta.title }}
                    {{#if meta.reading }}
                        <span class="text-gray-500">({{ meta.reading }})</span>
                    {{/if}}
                    </a>
                </h3>
            </li>
        </script>
      </pagefind-results>
    </div>
  </div>
</Layout>

<script>
  // @ts-ignore
  import "@pagefind/component-ui/css";
  import "@pagefind/component-ui";
</script>
