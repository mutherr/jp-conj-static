---
import verbs from "../../data/verbs.json";
import BaseLayout from "../../layouts/Layout.astro";

const sortedVerbs = verbs.sort((a, b) => a.reading.localeCompare(b.reading));
const verbsData = sortedVerbs.map((verb) => ({
  id: verb.id,
  term: verb.term,
  reading: verb.reading,
  furigana: verb.furigana || "",
  type: verb.type || "",
}));
---

<BaseLayout>
  <section class="space-y-6">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-bold">Browse Verbs</h1>
      <p class="text-base-content/70 text-sm sm:text-base">
        Search by kanji or reading, then filter by verb group.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
      <label class="form-control md:col-span-2">
        <div class="label">
          <span class="label-text">Search</span>
        </div>
        <input
          id="verb-search"
          type="search"
          class="input input-bordered w-full"
          placeholder="Type kanji or reading..."
        />
      </label>

      <label class="form-control">
        <div class="label">
          <span class="label-text">Group</span>
        </div>
        <select id="verb-group" class="select select-bordered w-full">
          <option value="all">All</option>
          <option value="ichidan">Ichidan</option>
          <option value="godan">Godan</option>
          <option value="irregular">Irregular</option>
        </select>
      </label>

      <label class="form-control">
        <div class="label">
          <span class="label-text">Per page</span>
        </div>
        <select id="verbs-per-page" class="select select-bordered w-full">
          <option value="48">48</option>
          <option value="96" selected>96</option>
          <option value="192">192</option>
        </select>
      </label>
    </div>

    <div class="flex items-center justify-between gap-3">
      <p id="verbs-results" class="text-sm text-base-content/70">Loading...</p>
      <button id="clear-filters" class="btn btn-sm btn-ghost">Clear</button>
    </div>

    <div
      id="verbs-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3"
      aria-live="polite"
    >
    </div>

    <div class="flex items-center justify-center gap-4">
      <button id="page-prev" class="btn btn-sm">Previous</button>
      <span id="page-indicator" class="text-sm text-base-content/70"
        >Page 1</span
      >
      <button id="page-next" class="btn btn-sm">Next</button>
    </div>
  </section>

  <script is:inline define:vars={{ verbsData }}>
    const verbs = verbsData;

    const searchInput = document.getElementById("verb-search");
    const groupSelect = document.getElementById("verb-group");
    const perPageSelect = document.getElementById("verbs-per-page");
    const clearButton = document.getElementById("clear-filters");
    const resultsText = document.getElementById("verbs-results");
    const grid = document.getElementById("verbs-grid");
    const prevButton = document.getElementById("page-prev");
    const nextButton = document.getElementById("page-next");
    const pageIndicator = document.getElementById("page-indicator");

    const GROUP_VALUES = new Set(["all", "ichidan", "godan", "irregular"]);
    const PER_PAGE_VALUES = new Set(["48", "96", "192"]);

    let currentPage = 1;

    const escapeHtml = (value) =>
      value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");

    const classifyGroup = (type) => {
      if (String(type).includes("v1")) {
        return "ichidan";
      }
      if (String(type).includes("v5")) {
        return "godan";
      }
      return "irregular";
    };

    const withSearchText = verbs.map((verb) => ({
      ...verb,
      group: classifyGroup(verb.type),
      searchText: `${verb.term} ${verb.reading}`.toLowerCase(),
    }));

    const createVerbCard = (verb) => {
      const card = document.createElement("a");
      card.href = `/verbs/${verb.reading}-${verb.id}`;
      card.className =
        "card bg-base-100 border border-base-300 shadow-sm hover:shadow-md hover:border-primary/40 hover:-translate-y-0.5 transition-all duration-150 group";

      const body = document.createElement("div");
      body.className = "card-body p-4 gap-2";

      const row = document.createElement("div");
      row.className = "flex items-start justify-between gap-3";

      const term = document.createElement("span");
      term.className =
        "text-2xl font-bold group-hover:text-primary transition-colors possible-furigana";
      term.innerHTML = verb.furigana || escapeHtml(verb.term);

      const badge = document.createElement("span");
      badge.className = "badge badge-outline badge-sm mt-1";
      badge.textContent =
        verb.group === "ichidan"
          ? "Ichidan"
          : verb.group === "godan"
            ? "Godan"
            : "Irregular";

      row.append(term, badge);

      const reading = document.createElement("span");
      reading.className = "text-sm text-base-content/60";
      reading.textContent = verb.reading;

      body.append(row, reading);
      card.append(body);
      return card;
    };

    const filteredVerbs = () => {
      const query = searchInput.value.trim().toLowerCase();
      const group = groupSelect.value;

      return withSearchText.filter((verb) => {
        const matchesGroup = group === "all" || verb.group === group;
        const matchesQuery = !query || verb.searchText.includes(query);
        return matchesGroup && matchesQuery;
      });
    };

    const applyStateFromUrl = () => {
      const params = new URLSearchParams(window.location.search);

      const q = params.get("q") || "";
      const group = params.get("group") || "all";
      const perPage = params.get("perPage") || "96";
      const pageRaw = Number(params.get("page") || "1");

      searchInput.value = q;
      groupSelect.value = GROUP_VALUES.has(group) ? group : "all";
      perPageSelect.value = PER_PAGE_VALUES.has(perPage) ? perPage : "96";
      currentPage = Number.isInteger(pageRaw) && pageRaw > 0 ? pageRaw : 1;
    };

    const writeStateToUrl = () => {
      const params = new URLSearchParams();
      const q = searchInput.value.trim();
      const group = groupSelect.value;
      const perPage = perPageSelect.value;

      if (q) {
        params.set("q", q);
      }
      if (group !== "all") {
        params.set("group", group);
      }
      if (perPage !== "96") {
        params.set("perPage", perPage);
      }
      if (currentPage > 1) {
        params.set("page", String(currentPage));
      }

      const next = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ""}`;
      if (next !== `${window.location.pathname}${window.location.search}`) {
        history.replaceState(null, "", next);
      }
    };

    const render = () => {
      const perPage = Number(perPageSelect.value);
      const items = filteredVerbs();
      const totalPages = Math.max(1, Math.ceil(items.length / perPage));
      currentPage = Math.min(currentPage, totalPages);

      const start = (currentPage - 1) * perPage;
      const paged = items.slice(start, start + perPage);

      grid.innerHTML = "";
      if (paged.length === 0) {
        const empty = document.createElement("p");
        empty.className =
          "col-span-full text-center text-base-content/60 py-10";
        empty.textContent = "No verbs match your filters.";
        grid.append(empty);
      } else {
        const fragment = document.createDocumentFragment();
        for (const verb of paged) {
          fragment.append(createVerbCard(verb));
        }
        grid.append(fragment);
      }

      resultsText.textContent = `${items.length.toLocaleString()} matches`;
      pageIndicator.textContent = `Page ${currentPage} / ${totalPages}`;
      prevButton.disabled = currentPage <= 1;
      nextButton.disabled = currentPage >= totalPages;
      writeStateToUrl();
    };

    searchInput.addEventListener("input", () => {
      currentPage = 1;
      render();
    });

    groupSelect.addEventListener("change", () => {
      currentPage = 1;
      render();
    });

    perPageSelect.addEventListener("change", () => {
      currentPage = 1;
      render();
    });

    clearButton.addEventListener("click", () => {
      searchInput.value = "";
      groupSelect.value = "all";
      perPageSelect.value = "96";
      currentPage = 1;
      render();
    });

    prevButton.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage -= 1;
        render();
      }
    });

    nextButton.addEventListener("click", () => {
      currentPage += 1;
      render();
    });

    window.addEventListener("popstate", () => {
      applyStateFromUrl();
      render();
    });

    applyStateFromUrl();
    render();
  </script>
</BaseLayout>
