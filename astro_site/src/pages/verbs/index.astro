---
import verbs from "../../data/verbs.json";
import BaseLayout from "../../layouts/Layout.astro";

const sortedVerbs = verbs.sort((a, b) => a.reading.localeCompare(b.reading));
---

<BaseLayout>
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3"
  >
    {
      sortedVerbs.map((verb) => (
        <a
          href={`/verbs/${verb.reading}-${verb.id}`}
          class="card bg-base-100 border border-base-300 shadow-sm
               hover:shadow-md hover:border-primary/40 hover:-translate-y-0.5
               transition-all duration-150 group"
        >
          <div class="card-body p-4 gap-1">
            <span class="text-2xl font-bold group-hover:text-primary transition-colors possible-furigana">
              <Fragment set:html={verb.furigana || verb.term} />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
