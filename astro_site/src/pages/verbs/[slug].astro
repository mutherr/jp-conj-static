---
import ConjugationChart from "../../components/ConjugationChart.astro";
import verbs from "../../data/verbs.json";
import BaseLayout from "../../layouts/Layout.astro";
import { conjugateParts, type Conjugation } from "../../utils/conjugation";
import { toRuby } from "../../utils/ruby";
import { getVerbGroupBadge, getVerbGroupLabel } from "../../utils/verbs";

const verb = Astro.props.verb;
const termParts = conjugateParts(verb.term || verb.reading, verb.type);
const readingParts = conjugateParts(verb.reading || verb.term, verb.type);

// Stem in plain ink, ending (the part conjugation actually changes) in accent —
// same device as the homepage's vowel-row/ichidan demos, applied to every form.
const conjugation = Object.fromEntries(
  (Object.keys(termParts) as Array<keyof Conjugation>).map((key) => {
    const term = termParts[key];
    const reading = readingParts[key];
    const stem = toRuby(term.stem, reading.stem);
    const ending = toRuby(term.ending, reading.ending);
    return [
      key,
      ending ? `${stem}<mark class="suffix-mark">${ending}</mark>` : stem,
    ];
  }),
) as Conjugation;

export function getStaticPaths() {
  return verbs.map((verb) => ({
    params: { slug: `${verb.reading}-${verb.id}` },
    props: { verb },
  }));
}

const displayTerm = verb.furigana || verb.term;
const groupLabel = getVerbGroupLabel(verb.type);
const groupBadge = getVerbGroupBadge(verb.type);
---

<BaseLayout
  title={`${verb.term} conjugation | Japanese Verb Conjugation`}
  description={`Conjugation table for ${verb.term} (${verb.reading}), a Japanese ${groupLabel.toLowerCase()} verb.`}
>
  <div id="primary">
    <main id="main">
      <article class="single-pg-container" data-pagefind-body>
        <span data-pagefind-meta="title" hidden>{verb.term}</span>
        <span data-pagefind-meta="reading" data-pagefind-sort="reading" hidden
          >{verb.reading}</span
        >
        {
          verb.furigana && (
            <span data-pagefind-meta="furigana" hidden>
              {verb.furigana}
            </span>
          )
        }
        <span data-pagefind-meta="type" hidden>{verb.type}</span>
        <span data-pagefind-meta="group" data-pagefind-filter="group" hidden
          >{groupLabel}</span
        >
        {
          verb.definitions.length > 0 && (
            <span data-pagefind-meta="definitions" hidden>
              {verb.definitions.join("; ")}
            </span>
          )
        }
        <a
          href={`${import.meta.env.BASE_URL}verbs`}
          class="btn btn-ghost btn-sm mb-4">← Browse verbs</a
        >
        <p
          class="text-sm font-semibold uppercase tracking-widest text-accent mb-2"
        >
          Conjugation table
        </p>
        <h1
          lang="ja"
          class="entry-title verb-term-font text-4xl md:text-5xl font-bold possible-furigana"
        >
          <Fragment set:html={displayTerm} />
        </h1>
        <div
          class="flex flex-wrap items-center gap-3 mt-4 mb-8 text-base-content/70"
        >
          <span>Reading: <span lang="ja">{verb.reading}</span></span>
          <span class={`badge gap-1.5 ${groupBadge.badgeClass}`}>
            <span lang="ja">{groupBadge.kanji}</span>
            {groupLabel}
          </span>
        </div>

        {
          verb.definitions.length > 0 && (
            <div class="mb-8">
              <h2 class="flex items-center gap-2 text-sm uppercase tracking-wide text-base-content/60 font-semibold mb-3">
                <span class="section-mark" aria-hidden="true" />
                Meaning
              </h2>
              <ol class="list-decimal list-inside space-y-1">
                {verb.definitions.map((definition) => (
                  <li>{definition}</li>
                ))}
              </ol>
            </div>
          )
        }

        <ConjugationChart conjugations={conjugation} />
      </article>
    </main>
  </div>
</BaseLayout>
