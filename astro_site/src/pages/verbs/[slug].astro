---
import ConjugationChart from "../../components/ConjugationChart.astro";
import verbs from "../../data/verbs.json";
import BaseLayout from "../../layouts/Layout.astro";
import { conjugate } from "../../utils/conjugation";

const verb = Astro.props.verb;
const conjugation = conjugate(verb.furigana || verb.term, verb.type);

export function getStaticPaths() {
  return verbs.map((verb) => ({
    params: { slug: `${verb.reading}-${verb.id}` },
    props: { verb },
  }));
}

const displayTerm = verb.furigana || verb.term;
---

<BaseLayout>
  <div id="primary">
    <main id="main">
      <article class="single-pg-container" data-pagefind-body>
        <span data-pagefind-meta="title" hidden>{verb.term}</span>
        <span data-pagefind-meta="reading" hidden>{verb.reading}</span>
        {
          verb.furigana && (
            <span data-pagefind-meta="furigana" hidden>
              {verb.furigana}
            </span>
          )
        }
        <span data-pagefind-meta="type" hidden>{verb.type}</span>
        <h1
          class="entry-title text-2xl font-bold group-hover:text-primary transition-colors possible-furigana"
        >
          <Fragment set:html={`Conjugation table for ${displayTerm}`} />
        </h1>
      </article>

      <ConjugationChart conjugations={conjugation} />
    </main>
  </div>
</BaseLayout>

<style>
  .location {
    font-weight: bold;
  }
</style>
