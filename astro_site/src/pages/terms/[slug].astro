---
import BaseLayout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Verb = CollectionEntry<'verbs'>;

const { slug } = Astro.params;

const verbs = await getCollection('verbs');

const verb = verbs.find((verb: Verb) => verb.id === slug);
if (!verb) {
  throw new Error(`Verb not found for slug: ${slug}`);
}

export async function getStaticPaths() {
  const verbs = await getCollection('verbs');

  return verbs.map((verb: Verb) => ({
    params: { slug: verb.id },
    props: { verb },
  }));
}
---

<BaseLayout>
  <div id="primary">
    <main id="main">
      <article class="single-pg-container">
        <h1 class="entry-title">{verb.data.term}</h1>
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .location {
    font-weight: bold;
  }
</style>