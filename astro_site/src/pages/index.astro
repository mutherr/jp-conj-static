---
import Layout from "../layouts/Layout.astro";
import verbs from "../data/verbs.json";
import { conjugate, type Conjugation } from "../utils/conjugation";
import { toRuby } from "../utils/ruby";

type Verb = (typeof verbs)[0] & { type?: string };

const totalVerbs = verbs.length;
const ichidanCount = (verbs as Verb[]).filter((v) => v.type === "v1").length;
const godanCount = (verbs as Verb[]).filter((v) =>
  v.type.includes("v5"),
).length;

// Wraps the character immediately after the first </ruby> — for a stem+row-kana
// word that's always the row-defining okurigana (か/き/く/け/こ for 書く).
function markRowKana(html: string): string {
  return html.replace(/<\/ruby>(.)/, '</ruby><mark class="row-mark">$1</mark>');
}

// Wraps everything after the stem (ruby kanji + one static okurigana kana) —
// for an ichidan verb that's always the changing suffix (べ stays, the rest moves).
function markSuffix(html: string): string {
  const idx = html.indexOf("</ruby>");
  if (idx === -1) return html;
  const cut = idx + "</ruby>".length + 1;
  return `${html.slice(0, cut)}<mark class="suffix-mark">${html.slice(cut)}</mark>`;
}

function rubyAll(term: string, reading: string, type: string): Conjugation {
  const termConj = conjugate(term, type);
  const readingConj = conjugate(reading, type);
  return Object.fromEntries(
    (Object.keys(termConj) as Array<keyof Conjugation>).map((key) => [
      key,
      toRuby(termConj[key], readingConj[key]),
    ]),
  ) as Conjugation;
}

// Signature: 書く walked across all five gojuon vowel-row endings.
const kaku = rubyAll("書く", "かく", "v5");
const vowelRow = [
  { row: "あ", label: "Negative", form: markRowKana(kaku.negative) },
  { row: "い", label: "Polite stem", form: markRowKana(kaku.polite) },
  {
    row: "う",
    label: "Dictionary",
    form: markRowKana(kaku.dictionary),
    anchor: true,
  },
  { row: "え", label: "Potential", form: markRowKana(kaku.potential) },
  { row: "お", label: "Volitional", form: markRowKana(kaku.volitional) },
];

// Ichidan mechanism: 食べる — the stem never moves, only the tail does.
const taberu = rubyAll("食べる", "たべる", "v1");
const ichidanForms = [
  { label: "Negative", form: markSuffix(taberu.negative) },
  { label: "Past", form: markSuffix(taberu.past) },
  { label: "Potential", form: markSuffix(taberu.potential) },
];
---

<Layout
  title="Japanese Verb Conjugation Reference"
  description={`Browse conjugation tables for ${totalVerbs.toLocaleString()} Japanese verbs, with readings and furigana.`}
>
  <!-- Hero thesis -->
  <section class="mb-16">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent mb-3">
      How conjugation works
    </p>
    <h1 class="text-3xl md:text-4xl font-bold mb-4 max-w-2xl">
      One verb, five endings
    </h1>
    <p class="max-w-2xl text-base-content/70 mb-8">
      Every godan verb's ending moves through the same five gojūon sounds.{" "}
      <span lang="ja">書く</span>'s stem ends in <span lang="ja">く</span>, so
      it cycles through the <span lang="ja">か・き・く・け・こ</span> row — and which
      one you land on decides the grammar.
    </p>

    <div class="vowel-row possible-furigana">
      {
        vowelRow.map((cell) => (
          <div class={`vowel-cell${cell.anchor ? " is-anchor" : ""}`}>
            <span lang="ja" class="kana-row">
              {cell.row}行
            </span>
            <span lang="ja" class="conjugated-form" set:html={cell.form} />
            <span class="form-label">{cell.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- At a glance -->
  <section class="mb-16">
    <div
      class="stats stats-vertical sm:stats-horizontal shadow bg-base-100 w-full"
    >
      <div class="stat place-items-center">
        <div class="stat-title">Total verbs</div>
        <div class="stat-value text-primary">{totalVerbs}</div>
      </div>
      <div class="stat place-items-center">
        <div class="stat-title">Ichidan</div>
        <div class="stat-value text-secondary">{ichidanCount}</div>
      </div>
      <div class="stat place-items-center">
        <div class="stat-title">Godan</div>
        <div class="stat-value text-accent">{godanCount}</div>
      </div>
    </div>
    <p class="text-xs text-base-content/70 mt-3 max-w-2xl">
      Sourced from the 2026/5/11 build of <a
        class="link"
        href="https://github.com/yomidevs/jmdict-yomitan">JMDict-Yomitan</a
      >, filtered to verbs. Furigana is generated by longest-common-subsequence
      alignment between each written form and its reading, so rare alignment
      errors may remain. <span lang="ja">誤字を見つけたら教えてね！</span>
    </p>
  </section>

  <!-- Verb group reference -->
  <section>
    <h2 class="text-2xl font-bold mb-6">Verb Groups</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Ichidan -->
      <div class="card bg-base-100 border border-base-300">
        <div class="card-body gap-4">
          <div class="flex items-center gap-2">
            <span lang="ja" class="badge badge-secondary">一段</span>
            <h3 class="font-bold text-lg">Ichidan</h3>
          </div>
          <p class="text-sm text-base-content/70">
            Also called <strong>ru-verbs</strong>. The stem is fixed — only the
            part after it changes.
          </p>
          <div class="space-y-2 possible-furigana">
            {
              ichidanForms.map((entry) => (
                <div class="flex items-center justify-between text-sm">
                  <span lang="ja" set:html={entry.form} />
                  <span class="text-base-content/70 text-xs">
                    {entry.label}
                  </span>
                </div>
              ))
            }
          </div>
          <div class="stem-legend text-base-content/70">
            <span class="swatch" style="background: var(--color-base-content);"
            ></span> stem <span
              class="swatch"
              style="background: var(--color-accent); margin-left: 0.5rem;"
            ></span> changing tail
          </div>
        </div>
      </div>

      <!-- Godan -->
      <div class="card bg-base-100 border border-base-300">
        <div class="card-body gap-4">
          <div class="flex items-center gap-2">
            <span lang="ja" class="badge badge-primary">五段</span>
            <h3 class="font-bold text-lg">Godan</h3>
          </div>
          <p class="text-sm text-base-content/70">
            Also called <strong>u-verbs</strong>. The final kana shifts across
            the five vowel-row sounds shown above.
          </p>
          <table class="table table-xs">
            <thead><tr><th>Form</th><th lang="ja">書く</th></tr></thead>
            <tbody class="possible-furigana">
              <tr
                ><td>Negative</td><td
                  lang="ja"
                  set:html={markRowKana(kaku.negative)}
                /></tr
              >
              <tr><td>Past</td><td lang="ja" set:html={kaku.past} /></tr>
              <tr
                ><td>Potential</td><td
                  lang="ja"
                  set:html={markRowKana(kaku.potential)}
                /></tr
              >
            </tbody>
          </table>
        </div>
      </div>

      <!-- Irregular -->
      <div class="card bg-base-100 border border-base-300">
        <div class="card-body gap-4">
          <div class="flex items-center gap-2">
            <span lang="ja" class="badge badge-neutral">不規則</span>
            <h3 class="font-bold text-lg">Irregular</h3>
          </div>
          <p class="text-sm text-base-content/70">
            Only two true irregulars: <strong lang="ja">する</strong> and <strong
              lang="ja">くる</strong
            >. Must be memorised.
          </p>
          <table class="table table-xs">
            <thead
              ><tr
                ><th>Form</th><th lang="ja">する</th><th lang="ja">くる</th></tr
              ></thead
            >
            <tbody>
              <tr>
                <td>Negative</td><td lang="ja">しない</td><td lang="ja"
                  >こない</td
                >
              </tr>
              <tr>
                <td>Past</td><td lang="ja">した</td><td lang="ja">きた</td>
              </tr>
              <tr>
                <td><span lang="ja">て</span> form</td><td lang="ja">して</td
                ><td lang="ja">きて</td>
              </tr>
              <tr>
                <td>Potential</td><td lang="ja">できる</td><td lang="ja"
                  >こられる</td
                >
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Layout>
