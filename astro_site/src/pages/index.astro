---
import Layout from "../layouts/Layout.astro";
import verbs from "../data/verbs.json";

type Verb = (typeof verbs)[0] & { type?: string };

const totalVerbs = verbs.length;
const ichidanCount = (verbs as Verb[]).filter((v) => v.type === "v1").length;
const godanCount = (verbs as Verb[]).filter((v) =>
  v.type.includes("v5"),
).length;
---

<Layout
  title="Japanese Verb Conjugation Reference"
  description={`Browse conjugation tables for ${totalVerbs.toLocaleString()} Japanese verbs, with readings and furigana.`}
>
  <!-- Stats -->
  <section>
    <h2 class="text-2xl font-bold mb-6">Overview</h2>
    <p class="mb-6">
      This site is intended as a reference for Japanese verb conjugation. It
      covers {totalVerbs.toLocaleString()} verbs and is not exhaustive. The data is
      sourced from the 2026/5/11 version of the <a
        href="https://github.com/yomidevs/jmdict-yomitan"
        >JMDict-Yomitan
      </a> project and filtered to include verbs. Furigana is generated by a custom
      longest-common-subsequence alignment of each written form and reading, so rare
      alignment errors may remain. 誤字を見つけたら教えてね！
    </p>

    <div
      class="stats stats-horizontal shadow bg-base-100 w-full mb-12 overflow-x-auto"
    >
      <div class="stat place-items-center">
        <div class="stat-title">Total Verbs</div>
        <div class="stat-value text-primary">{totalVerbs}</div>
      </div>
      <div class="stat place-items-center">
        <div class="stat-title">Ichidan</div>
        <div class="stat-value text-accent">{ichidanCount}</div>
      </div>
      <div class="stat place-items-center">
        <div class="stat-title">Godan</div>
        <div class="stat-value text-secondary">{godanCount}</div>
      </div>
    </div>

    <!-- Verb group reference -->
    <section>
      <h2 class="text-2xl font-bold mb-6">Verb Groups</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Ichidan -->
        <div class="card bg-base-100 border border-base-300">
          <div class="card-body gap-4">
            <div class="flex items-center gap-2">
              <span class="badge badge-accent">一段</span>
              <h3 class="font-bold text-lg">Ichidan</h3>
            </div>
            <p class="text-sm text-base-content/60">
              Also called <strong>ru-verbs</strong>. The stem never changes —
              drop る and add the ending.
            </p>
            <table class="table table-xs">
              <thead><tr><th>Form</th><th>食べる</th></tr></thead>
              <tbody>
                <tr><td>Negative</td><td>食べない</td></tr>
                <tr><td>Past</td><td>食べた</td></tr>
                <tr><td>て form</td><td>食べて</td></tr>
                <tr><td>Potential</td><td>食べられる</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Godan -->
        <div class="card bg-base-100 border border-base-300">
          <div class="card-body gap-4">
            <div class="flex items-center gap-2">
              <span class="badge badge-primary">五段</span>
              <h3 class="font-bold text-lg">Godan</h3>
            </div>
            <p class="text-sm text-base-content/60">
              Also called <strong>u-verbs</strong>. The final sound shifts
              across the five vowel rows.
            </p>
            <table class="table table-xs">
              <thead><tr><th>Form</th><th>書く</th></tr></thead>
              <tbody>
                <tr><td>Negative</td><td>書かない</td></tr>
                <tr><td>Past</td><td>書いた</td></tr>
                <tr><td>て form</td><td>書いて</td></tr>
                <tr><td>Potential</td><td>書ける</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Irregular -->
        <div class="card bg-base-100 border border-base-300">
          <div class="card-body gap-4">
            <div class="flex items-center gap-2">
              <span class="badge badge-neutral">不規則</span>
              <h3 class="font-bold text-lg">Irregular</h3>
            </div>
            <p class="text-sm text-base-content/60">
              Only two true irregulars: <strong>する</strong> and <strong
                >くる</strong
              >. Must be memorised.
            </p>
            <table class="table table-xs">
              <thead><tr><th>Form</th><th>する</th><th>くる</th></tr></thead>
              <tbody>
                <tr><td>Negative</td><td>しない</td><td>こない</td></tr>
                <tr><td>Past</td><td>した</td><td>きた</td></tr>
                <tr><td>て form</td><td>して</td><td>きて</td></tr>
                <tr><td>Potential</td><td>できる</td><td>こられる</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </section>
</Layout>
