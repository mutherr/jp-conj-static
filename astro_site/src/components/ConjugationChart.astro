---
let { conjugations } = Astro.props;

type ChartEntry = {
  label: string;
  plain: string;
  polite?: string;
  note?: string;
  isBase?: boolean;
};

const sections: Array<{ title: string; entries: ChartEntry[] }> = [
  {
    title: "Core Tense",
    entries: [
      {
        label: "Dictionary",
        plain: conjugations.dictionary,
        polite: conjugations.polite,
        isBase: true,
      },
      {
        label: "Negative",
        plain: conjugations.negative,
        polite: conjugations.negativePolite,
      },
      {
        label: "Past",
        plain: conjugations.past,
        polite: conjugations.pastPolite,
      },
      {
        label: "Past Negative",
        plain: conjugations.negativePast,
        polite: conjugations.negativePastPolite,
      },
      {
        label: "Te Form",
        plain: conjugations.te,
        note: "No separate polite te-form",
      },
    ],
  },
  {
    title: "Voice and Potential",
    entries: [
      {
        label: "Potential",
        plain: conjugations.potential,
        polite: conjugations.potentialPolite,
      },
      {
        label: "Passive",
        plain: conjugations.passive,
        polite: conjugations.passivePolite,
      },
      {
        label: "Causative",
        plain: conjugations.causative,
        note: "Polite variant not shown",
      },
    ],
  },
  {
    title: "Command and Intent",
    entries: [
      {
        label: "Imperative",
        plain: conjugations.imperative,
        note: "Direct command form",
      },
      {
        label: "Volitional",
        plain: conjugations.volitional,
        polite: conjugations.volitionalPolite,
        note: "Let's do ...",
      },
    ],
  },
];
---

<div class="space-y-6">
  {
    sections.map((section) => (
      <section class="space-y-3">
        <h2 class="flex items-center gap-2 text-sm uppercase tracking-wide text-base-content/60 font-semibold">
          <span class="section-mark" aria-hidden="true" />
          {section.title}
        </h2>

        <div class="hidden md:block overflow-x-auto rounded-box border border-base-300 bg-base-100">
          <table class="table w-full">
            <thead>
              <tr>
                <th class="w-40">Form</th>
                <th>Plain</th>
                <th>Polite</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-300">
              {section.entries.map((entry) => (
                <tr class={entry.isBase && "is-anchor-row"}>
                  <td>
                    <div class="font-medium flex flex-wrap items-center gap-2">
                      {entry.label}
                      {entry.isBase && (
                        <span class="badge badge-primary badge-xs whitespace-nowrap">
                          Base form
                        </span>
                      )}
                    </div>
                    {entry.note && (
                      <div class="text-xs text-base-content/60 mt-1">
                        {entry.note}
                      </div>
                    )}
                  </td>
                  <td class="possible-furigana font-medium">
                    <Fragment set:html={entry.plain} />
                  </td>
                  <td class="possible-furigana">
                    {entry.polite ? (
                      <Fragment set:html={entry.polite} />
                    ) : (
                      <span class="text-base-content/50">-</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:hidden">
          {section.entries.map((entry) => (
            <article
              class={`card bg-base-100 border border-base-300 shadow-sm ${entry.isBase ? "is-anchor-card" : ""}`}
            >
              <div class="card-body p-4 gap-3">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-semibold">{entry.label}</h3>
                  {entry.isBase && (
                    <span class="badge badge-primary badge-xs whitespace-nowrap">
                      Base form
                    </span>
                  )}
                </div>

                <div class="space-y-2 text-sm">
                  <div class="flex flex-col gap-1">
                    <span class="text-base-content/60 uppercase tracking-wide text-xs">
                      Plain
                    </span>
                    <span class="possible-furigana font-medium">
                      <Fragment set:html={entry.plain} />
                    </span>
                  </div>

                  <div class="flex flex-col gap-1">
                    <span class="text-base-content/60 uppercase tracking-wide text-xs">
                      Polite
                    </span>
                    <span class="possible-furigana">
                      {entry.polite ? (
                        <Fragment set:html={entry.polite} />
                      ) : (
                        <span class="text-base-content/50">-</span>
                      )}
                    </span>
                  </div>
                </div>

                {entry.note && (
                  <p class="text-xs text-base-content/60">{entry.note}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</div>
