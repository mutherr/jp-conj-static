---
let { conjugations } = Astro.props;

type ChartEntry = {
  label: string;
  plain: string;
  polite?: string;
  note?: string;
  isBase?: boolean;
};

const sections: Array<{ title: string; entries: ChartEntry[] }> = [
  {
    title: "Core Tense",
    entries: [
      {
        label: "Dictionary",
        plain: conjugations.dictionary,
        polite: conjugations.polite,
        isBase: true,
      },
      {
        label: "Negative",
        plain: conjugations.negative,
        polite: conjugations.negativePolite,
      },
      {
        label: "Past",
        plain: conjugations.past,
        polite: conjugations.pastPolite,
      },
      {
        label: "Past Negative",
        plain: conjugations.negativePast,
        polite: conjugations.negativePastPolite,
      },
      {
        label: "Te Form",
        plain: conjugations.te,
        note: "No separate polite te-form",
      },
    ],
  },
  {
    title: "Conditional and Desire",
    entries: [
      {
        label: "Conditional (ba)",
        plain: conjugations.conditional,
        note: "If/when ... — more formal, common in writing",
      },
      {
        label: "Conditional (tara)",
        plain: conjugations.tara,
        note: "If/when ... — more common in speech",
      },
      {
        label: "Want to",
        plain: conjugations.tai,
        note: "Conjugates like an i-adjective (たくない, たかった)",
      },
    ],
  },
  {
    title: "Voice and Potential",
    entries: [
      {
        label: "Potential",
        plain: conjugations.potential,
        polite: conjugations.potentialPolite,
      },
      {
        label: "Passive",
        plain: conjugations.passive,
        polite: conjugations.passivePolite,
      },
      {
        label: "Causative",
        plain: conjugations.causative,
        polite: conjugations.causativePolite,
      },
    ],
  },
  {
    title: "Command and Intent",
    entries: [
      {
        label: "Imperative",
        plain: conjugations.imperative,
        note: "Direct command form",
      },
      {
        label: "Volitional",
        plain: conjugations.volitional,
        polite: conjugations.volitionalPolite,
        note: "Let's do ...",
      },
    ],
  },
];
---

<div class="space-y-6">
  {
    sections.map((section) => (
      <section class="space-y-3">
        <h2 class="flex items-center gap-2 text-sm uppercase tracking-wide text-base-content/70 font-semibold">
          <span class="section-mark" aria-hidden="true" />
          {section.title}
        </h2>

        <div class="conj-table" role="table">
          <div class="conj-row conj-head" role="row">
            <span class="conj-cell" role="columnheader">
              Form
            </span>
            <span class="conj-cell" role="columnheader">
              Plain
            </span>
            <span class="conj-cell" role="columnheader">
              Polite
            </span>
          </div>

          {section.entries.map((entry) => (
            <div
              class={`conj-row ${entry.isBase ? "is-anchor-row" : ""}`}
              role="row"
            >
              <div class="conj-cell" role="cell">
                <div class="font-medium flex flex-wrap items-center gap-2">
                  {entry.label}
                  {entry.isBase && (
                    <span class="badge badge-primary badge-xs whitespace-nowrap">
                      Base form
                    </span>
                  )}
                </div>
                {entry.note && (
                  <div class="text-xs text-base-content/70 mt-1">
                    {entry.note}
                  </div>
                )}
              </div>

              <div
                lang="ja"
                class="conj-cell possible-furigana font-medium"
                role="cell"
                data-label="Plain"
              >
                <Fragment set:html={entry.plain} />
              </div>

              <div
                lang="ja"
                class="conj-cell possible-furigana"
                role="cell"
                data-label="Polite"
              >
                {entry.polite ? (
                  <Fragment set:html={entry.polite} />
                ) : (
                  <span class="text-base-content/70">-</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</div>
