---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      if (localStorage.getItem("showFurigana") === "false") {
        document.documentElement.classList.add("hide-furigana");
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Japanese Conjugation</title>
  </head>

  <body class="min-h-screen bg-base-200 flex flex-col">
    <nav
      class="navbar bg-base-100 shadow-sm sticky top-0 z-50 border-b border-base-300"
    >
      <div class="max-w-7xl mx-auto w-full px-4 flex">
        <!-- Left: logo -->
        <div class="flex-1">
          <a href="/" class="btn btn-ghost text-lg font-bold gap-2">
            <span class="text-2xl">🇯🇵</span>
            <span class="text-primary">日本語</span>
            <span
              class="hidden sm:inline text-base-content/70 font-normal text-sm"
            >
              Conjugation
            </span>
          </a>
        </div>

        <!-- Right: nav items + toggle all in one place -->
        <div class="flex-none flex items-center gap-1">
          <a href="/verbs" class="btn btn-ghost btn-sm">Verbs</a>

          <div class="divider divider-horizontal mx-0"></div>

          <button id="furigana-toggle" class="btn btn-ghost btn-sm gap-2">
            <span>Furigana</span>
            <span id="furigana-indicator" class="badge badge-sm">ON</span>
          </button>
        </div>
      </div>
    </nav>

    <main class="flex-1 max-w-7xl mx-auto w-full px-4 py-10">
      <slot />
    </main>

    <footer
      class="footer footer-center p-6 bg-base-100 border-t border-base-300 text-base-content/50 text-sm"
    >
      <p>Japanese Conjugation Reference</p>
    </footer>
  </body>
</html>
