---
import FuriganaToggle from "../components/FuriganaToggle.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Japanese Verb Conjugation",
  description = "Browse and search Japanese verb conjugations with readings and furigana.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html
  lang="en"
  style={`--washi-light-url: url(${base}textures/washi-light.webp); --washi-dark-url: url(${base}textures/washi-dark.webp);`}
>
  <head>
    <script is:inline>
      if (localStorage.getItem("showFurigana") === "false") {
        document.documentElement.classList.add("hide-furigana");
      }
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme === "light" || storedTheme === "dark") {
        document.documentElement.setAttribute("data-theme", storedTheme);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-base-200 flex flex-col">
    <nav
      data-pagefind-ignore
      class="navbar bg-base-100 shadow-sm sticky top-0 z-50 border-b border-base-300"
    >
      <div class="max-w-7xl mx-auto w-full px-4 flex">
        <div class="flex-1 min-w-0">
          <a href={base} class="btn btn-ghost text-lg font-bold gap-2 shrink-0">
            <span
              lang="ja"
              class="text-primary whitespace-nowrap"
              style="font-family: 'Shippori Mincho', serif;">動詞</span
            >
            <span
              class="hidden sm:inline text-base-content/70 font-normal text-sm"
            >
              Conjugation
            </span>
          </a>
        </div>

        <div class="flex-none flex items-center gap-1">
          <a
            href={`${base}verbs`}
            class="btn btn-ghost btn-sm"
            aria-label="Browse verbs"
          >
            <svg
              class="w-4 h-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="hidden sm:inline">Browse verbs</span>
          </a>

          <div class="divider divider-horizontal mx-0"></div>

          <FuriganaToggle />

          <div class="divider divider-horizontal mx-0"></div>

          <ThemeToggle />
        </div>
      </div>
    </nav>

    <main class="flex-1 max-w-7xl mx-auto w-full px-4 py-10">
      <slot />
    </main>

    <footer
      data-pagefind-ignore
      class="footer footer-center p-6 bg-base-100 border-t border-base-300 text-base-content/50 text-sm"
    >
      <p>Japanese Conjugation Reference</p>
    </footer>
  </body>
</html>
