{
  "name": "jp_conjugation_site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "resolutions": {
    "vite": "6.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --base=/",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "astro check && eslint . && npm run stylelint",
    "lint:fix": "eslint . --fix && npm run stylelint:fix",
    "stylelint": "stylelint \"src/**/*.{css,astro}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
    "format": "prettier --write .",
    "test": "vitest run src",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.1.0",
    "astro-pagefind": "^2.0.1",
    "daisyui": "^5.5.23",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.61.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss-html": "^1.8.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.13.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
