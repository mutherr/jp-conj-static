{
  "css.customData": ["astro_site/.vscode/tailwind.json"],
  "files.associations": {
    "*.astro": "astro"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "eslint.nodePath": "astro_site/node_modules",
  "eslint.workingDirectories": [
    { "pattern": "astro_site" }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "astro"
  ],

  "prettier.prettierPath": "astro_site/node_modules/prettier",
  "prettier.configPath": "astro_site/.prettierrc.mjs",
  "prettier.documentSelectors": [
    "astro_site/**/*.astro"
  ],

  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  }
}